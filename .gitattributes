# Assimp prebuilt binaries are vendored via Git LFS so the plugin compiles on clone.
# Regenerate them with Scripts/BuildAssimp.ps1.
*.lib   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.so.*  filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
*.pdb   filter=lfs diff=lfs merge=lfs -text

# Plugin content. M_AssimpDefault is generated by Scripts/GenerateDefaultMaterial.py.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Sample models used by the automation tests.
# Only binary formats go to LFS. The hand-authored ASCII fixtures (.ply, .obj, .mtl, .stl)
# stay as ordinary text so they remain readable and diffable in review -- they are the
# specification of the expected conversion results, so being able to read them matters.
Tests/Data/**/*.glb  filter=lfs diff=lfs merge=lfs -text
Tests/Data/**/*.fbx  filter=lfs diff=lfs merge=lfs -text
Tests/Data/**/*.blend filter=lfs diff=lfs merge=lfs -text
Tests/Data/**/*.3ds  filter=lfs diff=lfs merge=lfs -text
Tests/Data/**/*.png  filter=lfs diff=lfs merge=lfs -text
Tests/Data/**/*.jpg  filter=lfs diff=lfs merge=lfs -text

# Normalise line endings for source.
*.cs    text eol=crlf
*.h     text eol=crlf
*.cpp   text eol=crlf
*.ps1   text eol=crlf
*.uplugin text eol=crlf
*.ini   text eol=crlf
*.md    text eol=lf
