# AssimpForUnreal test fixture: a single quad carrying UVs, a normal, and a named material.
# Exercises UV V-flipping (source (0,0) -> Unreal (0,1)) and material slot extraction.
mtllib Quad.mtl
o Quad
v -1 -1 0
v 1 -1 0
v 1 1 0
v -1 1 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
usemtl QuadMaterial
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
